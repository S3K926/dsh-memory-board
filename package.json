{
    "name": "dsh-memory-board",
    "version": "1.0.0",
    "description": "本地记忆（Local Memory）· Memory panel for the DSH web settings page: read, search, append and carefully edit a file-based memory archive.",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "dsh",
        "deepseek-harness",
        "cordis-plugin",
        "memory",
        "settings"
    ],
    "exports": {
        ".": "./index.js",
        "./client": "./client.js",
        "./package.json": "./package.json"
    },
    "files": [
    "index.js",
    "client.js",
    "lib",
    "templates",
    "cordis.patch.yml",
    "cordis.patch.example.yml",
    "README.md",
    "LICENSE"
  ],
    "meta": {
        "title": "记忆面板",
        "description": "本地记忆（Local Memory）· 把一份基于文件的记忆档案搬进设置页：概览 / 日记 / 状态 / 事件流 / 搜索，读写都带守卫。"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "immediately": true
        }
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.0.2",
        "@deepseek-ai/dsh-agent": "^0.2.0-rc.1",
        "@deepseek-ai/dsh-session": "^0.2.0-rc.1"
    },
    "author": "S3K926",
    "engines": {
        "dsh": ">=0.1.7-rc.2"
    }
}
